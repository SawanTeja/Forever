# Server Configuration
PORT=4000

# Database Configuration (Defaults to 'mongo' container service name in docker-compose)
MONGODB_URI=mongodb://mongo:27017

# Admin Credentials
ADMIN_EMAIL=admin@forever.com
ADMIN_PASSWORD=adminpassword123

# JWT Secret
JWT_SECRET=forever_super_secret_jwt_key_change_me_in_production

# Cloudinary (Image Uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# Payment Gateways (Optional for local browsing)
STRIPE_SECRET_KEY=your_stripe_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Upstash Redis Caching (Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
